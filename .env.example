# DartEvent Manager — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real values!

# --- Server ---
PORT=3001

# --- Database ---
DB_PATH=./data/dartevent.db

# --- Authentication ---
# JWT secret — MUST be at least 32 characters, random, unique per environment
JWT_SECRET=your-jwt-secret-min-32-chars-change-me
JWT_EXPIRY=8h

# --- Password Hashing ---
BCRYPT_ROUNDS=12

# --- CORS ---
# In production: set to your actual domain (no trailing slash)
CORS_ORIGIN=https://your-domain.com

# --- Default Admin (only used on first startup if no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-secure-password

# --- App URL (used for cancel links in registration) ---
APP_URL=https://your-domain.com

# --- Mail (optional — omit MAIL_HOST to use dry-run mode) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_FROM=noreply@your-domain.com
